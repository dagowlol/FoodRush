# =====================================================================
# FoodRush - cấu hình môi trường
# Copy file này thành .env rồi điền giá trị thật:
#   cp .env.example .env   (Windows: copy .env.example .env)
# =====================================================================


# ---------------------------------------------------------------------
# Cổng & timezone
# ---------------------------------------------------------------------
# Cổng mở web trên máy.
WEB_PORT=8080
TZ=Asia/Ho_Chi_Minh
APP_TIMEZONE=Asia/Ho_Chi_Minh


# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
DB_NAME=foodrush
DB_USERNAME=foodrush
DB_PASSWORD=doi_mat_khau_manh
DB_ROOT_PASSWORD=doi_mat_khau_root_khac
DB_POOL_SIZE=10

# update = tự tạo/cập nhật bảng theo entity (hợp cho môi trường đồ án).
# Nếu muốn dữ liệu bất biến hoàn toàn thì dùng validate.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false


# ---------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------
# Để trống thì app tự sinh secret tạm => mất token mỗi lần restart.
# Muốn token sống lâu thì điền chuỗi bất kỳ, ví dụ:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000


# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------
# Các origin của frontend được phép gọi API. Nhiều origin thì ngăn cách bằng dấu phẩy.
# Với bản docker-compose (web ở ${WEB_PORT}), thường chỉ cần dòng dưới:
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Nếu bạn chạy frontend bằng `npm run dev` (cổng 5173) ngoài Docker,
# bỏ comment dòng sau và bỏ dòng trên:
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173


# ---------------------------------------------------------------------
# Google OAuth2 (đăng nhập bằng Google)
# ---------------------------------------------------------------------
# Lấy ở Google Cloud Console > APIs & Services > Credentials.
# Trong Authorized redirect URIs phải có:
#   http://localhost:${WEB_PORT}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Trang FE nhận code sau khi đăng nhập.
OAUTH2_REDIRECT_URI=http://localhost:8080/auth/callback


# ---------------------------------------------------------------------
# Cloudinary (upload ảnh voucher)
# ---------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=five-star/vouchers
CLOUDINARY_MAX_FILE_SIZE=5MB
CLOUDINARY_MAX_REQUEST_SIZE=6MB
CLOUDINARY_MAX_FILE_SIZE_BYTES=5242880


# ---------------------------------------------------------------------
# Gửi email (đăng ký qua OTP)
# ---------------------------------------------------------------------
# Gmail cần "Mật khẩu ứng dụng" (App Password), không dùng mật khẩu chính.
# Bật xác thực 2 bước trước, rồi tạo App Password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=


# ---------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------
OTP_TTL_MINUTES=5
OTP_SENDER_NAME=FoodRush
OTP_SENDER_EMAIL=


# ---------------------------------------------------------------------
# Tài khoản quản trị (tạo sẵn giống tài khoản nhân viên)
# ---------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Quản trị Five Star
# Để trống => app tự sinh mật khẩu ngẫu nhiên 16 ký tự và ghi ra
# file trong volume `staff-data` (xem README).
ADMIN_PASSWORD=
# Nếu tài khoản có email này đã tồn tại (đăng ký qua Google hoặc form),
# nó sẽ được tự nâng lên vai trò ADMIN mỗi khi app khởi động.
# Email này cũng được dùng cho tài khoản admin tạo sẵn ở trên.
ADMIN_EMAIL=


# ---------------------------------------------------------------------
# Tài khoản nhân viên tạo sẵn
# ---------------------------------------------------------------------
SEED_ENABLED=true
SEED_STAFF_USERNAME=staff
SEED_STAFF_EMAIL=staff@fivestar.local
# Để trống => app tự sinh mật khẩu ngẫu nhiên 16 ký tự và ghi ra
# file trong volume `staff-data` (xem README).
SEED_STAFF_PASSWORD=
SEED_STAFF_DISPLAY_NAME=Nhân viên Five Star


# ---------------------------------------------------------------------
# Game / coin
# ---------------------------------------------------------------------
COIN_SCORE_DIVISOR=10
DAILY_COIN_EARNING_CAP=150
COUPON_EXPIRY_DAYS=7


# ---------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------
# Rỗng => frontend gọi /api trên chính origin, nginx của container đảo sang backend.
# Chỉ điền khi muốn frontend gọi thẳng ra ngoài, ví dụ khi deploy tách riêng:
# VITE_API_BASE_URL=http://192.168.1.10:8080
VITE_API_BASE_URL=